# Copiar a backend/.env y completar. NUNCA se commitea el .env.

# Base de datos
DATABASE_URL=postgresql://usuario:clave@localhost:5432/antai

# Firma de los tokens de sesión. Cualquier valor largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sin esto el backend NO arranca en producción, a propósito.
JWT_SECRET=

# Primer administrador. `npm run seed` lo crea con esta clave y lo obliga
# a cambiarla en el primer ingreso. Después de crearlo, borrar estas dos
# líneas del .env: una clave que quedó escrita en un archivo ya no es
# secreta.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo. Sin SMTP_HOST el mailer imprime por consola en vez de enviar,
# que es lo que corresponde en desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_DESDE="Antai Mineral Mark <hola@antai.cl>"

# URL pública, para armar los enlaces de cancelación de los correos.
URL_PUBLICA=http://localhost:5173

PORT=3001
